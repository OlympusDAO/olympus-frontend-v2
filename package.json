{
  "name": "olympus-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint --write src/",
    "lint:check": "biome check src/",
    "lint:fix": "pnpm run lint",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "prepare": "husky",
    "codegen": "orval",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tree": "node scripts/make-test-tree.ts",
    "fork:setup": "node scripts/fork-setup.ts",
    "sourcemap:upload": "posthog-cli sourcemap inject --directory ./dist/assets && posthog-cli sourcemap upload --directory ./dist/assets"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.25.0",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@number-flow/react": "^0.5.14",
    "@olympusdao/treasury-subgraph-client": "^3.0.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "@wagmi/core": "^2.22.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dnum": "^2.18.1",
    "driver.js": "^1.11.0",
    "lottie-react": "^2.4.2",
    "lucide-react": "^0.525.0",
    "nuqs": "^2.10.3",
    "posthog-js": "^1.447.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-ga4": "^2.1.0",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "viem": "^2.57.18",
    "wagmi": "^2.19.5"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@posthog/cli": "^0.7.34",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "orval": "^8.47.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^4.5.0",
    "vite-plugin-webfont-dl": "^3.14.0",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
